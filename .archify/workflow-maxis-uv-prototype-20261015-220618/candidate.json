  "cards": [
    { "dot": "emerald", "title": "MVP scope and circulation", "items": ["Start with an existing recycled-polystyrene membrane module, feed tank, controlled pump, holder and sensors. Upstream fabrication shows the wider circular concept.", "Representative greywater/rainwater test water is used under controlled conditions. Define the test-loop return and sample collection during physical assembly."] },
    { "dot": "violet", "title": "Innovation 2: UV-assisted photocatalysis", "items": ["Proposed downstream UV/TiO2 stage follows membrane filtration. Use a compatible catalyst configuration and controlled UV exposure.", "Proposed mechanism: sufficient-energy light activates TiO2, producing electron-hole pairs and reactive species that may degrade selected organics.", "Compare matched UV-on and UV-off runs. Record pollutant removal, flux, fouling indicators and flux recovery; improvements are experimental questions."] },
    { "dot": "cyan", "title": "Membrane self-cleaning is a separate test", "items": ["A downstream treatment result alone does not establish membrane self-cleaning. Define how UV reaches the selected photocatalytic membrane when testing membrane-local effects.", "Check membrane/catalyst compatibility and stability. Reduced chemical-cleaning demand requires suitable comparative experiments.", "Background: Proof of Concept for Light Conducting Membrane Substrate for UV-Activated Photocatalysis as an Alternative to Chemical Cleaning (2018), https://pmc.ncbi.nlm.nih.gov/articles/PMC6315485/"] },
    { "dot": "amber", "title": "Energy integration and operating schedules", "items": ["Meter solar generation and electrical use of the pump, UV equipment and sensors; quantify grid demand where grid support is used.", "Compare operating schedules, including treatment during favourable solar generation. Reduced grid demand is a measured outcome, not an assumed benefit.", "Dashboard demonstration: heavy rainfall, low solar generation, low storage and increased fouling, with simulated weather forecasts clearly identified."] },
    { "dot": "rose", "title": "Validate before making reuse claims", "items": ["Water levels, flow, pressure, energy use and membrane-condition indicators feed the ESP32 or equivalent controller and computer dashboard.", "Safe non-potable reuse, photocatalytic efficacy and reduced chemical use require suitable experimental validation. IoT readings alone do not establish reuse safety.", "Failed or unknown quality remains on hold; potential reuse is irrigation, toilet flushing and township maintenance only after validation."] }
